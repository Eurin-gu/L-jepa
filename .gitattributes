# ---------------------------------------------------------------------------
# 行尾与二进制策略
#
# 为什么需要这个文件：
#   本仓库跨 Windows / WSL2 两侧使用，且含 181 个必须在 Linux 下执行的 .sh。
#   Windows git 默认 core.autocrlf=true 会在 checkout 时把 LF 转成 CRLF，
#   带 CRLF 的 shell 脚本在 WSL 里会报 "bash\r: No such file or directory"。
#   实测基线（2026-09-07）：仓库 210 个文本文件全部为 LF，0 个 CRLF。
#   故统一锁定 LF，两侧行为一致。
# ---------------------------------------------------------------------------

# 默认：文本自动检测，仓库内与工作区一律 LF
* text=auto eol=lf

# 显式声明文本类型（防止 auto 检测误判）
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.f     text eol=lf
*.f90   text eol=lf
*.r     text eol=lf
*.R     text eol=lf
*.inc   text eol=lf
*.log   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.patch text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 二进制：禁止任何行尾转换与文本 diff
# 溯源/审计链文件：这些 CSV 参与 sha256 指纹与预注册审计，
# 实测为混合换行符，一律按原始字节保存，禁止 git 重写行尾。
data/build/manifests/**        -text
data/build/arm_*.csv           -text
data/receptors_v2/**           -text
planning/*.csv                 -text

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.mp4   binary
*.webm  binary
*.gz    binary
*.zip   binary
*.tar   binary
*.whl   binary
*.pt    binary
*.pth   binary
*.npy   binary
*.npz   binary
*.nc    binary
*.rds   binary
*.grib  binary
*.grib2 binary
*.so    binary
*.o     binary
*.a     binary
*.pyd   binary
*.dll   binary
*.exe   binary
